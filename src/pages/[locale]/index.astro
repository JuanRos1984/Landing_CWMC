---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Services from "../../components/Services.astro";
import CTA from "../../components/CTA.astro";
import ContactForm from "../../components/ContactForm.astro";
import { getPage } from "../../lib/api";
import type { Locale } from "../../types/pages";

const validLocales: Locale[] = ["en", "es", "fr"];
const { locale } = Astro.params;

// Cualquier idioma fuera de la lista es una URL inexistente, no una copia
// del sitio en ingles: se responde 404 para no generar contenido duplicado.
if (!validLocales.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const page = await getPage("home", locale as Locale);
---

<BaseLayout title={page.hero.companyName}>
  <ContactForm slot="contact-form" />
  
  <Hero
    companyName={page.hero.companyName}
    title={page.hero.headline}
    description={page.hero.description}
    buttonText={page.hero.buttonText}
    buttonUrl={page.hero.buttonUrl}
  />
  
  <About data={page.about} />
  <Services data={page.services} />
   
  <CTA data={page.cta} />
</BaseLayout>
