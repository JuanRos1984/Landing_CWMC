---
// src/components/ContactForm.astro
//
// El sitio es estatico, asi que el formulario no puede enviarse a si mismo:
// necesita un servidor encendido al otro lado. Ese servidor es Strapi, que ya
// esta siempre activo para el gestor de contenido, y expone /api/contact.
//
// El destinatario del correo vive en la configuracion de Strapi
// (CONTACT_TO_EMAIL). Este componente nunca lo conoce ni lo envia.

const strapiUrl =
  import.meta.env.PUBLIC_STRAPI_URL ??
  import.meta.env.STRAPI_URL ??
  "http://localhost:1337";

const contactEndpoint =
  import.meta.env.PUBLIC_CONTACT_ENDPOINT ??
  `${strapiUrl.replace(/\/$/, "")}/api/contact`;
---

<!-- Modal overlay -->
<div 
  x-show="showContactForm" 
  @click.away="showContactForm = false"
  @keydown.escape="showContactForm = false"
  class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
  style="display: none;"
  x-cloak
>
  <!-- Modal content -->
  <div 
    class="bg-white rounded-xl shadow-2xl max-w-md w-full"
    @click.stop
  >
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b">
      <h3 class="text-2xl font-bold text-gray-900">Contact Us</h3>
      <button 
        type="button"
        aria-label="Close"
        @click="showContactForm = false"
        class="text-gray-400 hover:text-gray-600 transition text-2xl"
      >
        &times;
      </button>
    </div>

    <!-- Form -->
    <div class="p-6">
      <form
        data-endpoint={contactEndpoint}
        x-data="{
          formName: '',
          formEmail: '',
          formMessage: '',
          formWebsite: '',
          isSending: false,
          messageSent: false,
          errorMessage: '',

          async enviarFormulario() {
            this.isSending = true;
            this.messageSent = false;
            this.errorMessage = '';

            try {
              const datos = {
                name: this.formName,
                email: this.formEmail,
                message: this.formMessage,
                website: this.formWebsite
              };

              const response = await fetch(this.$el.dataset.endpoint, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(datos),
                signal: AbortSignal.timeout(45000)
              });

              const responseText = await response.text();

              let data;
              try {
                data = JSON.parse(responseText);
              } catch (e) {
                throw new Error('Something went wrong. Please try again.');
              }

              if (!response.ok) {
                throw new Error(data.error || 'Could not send your message.');
              }

              this.messageSent = true;
              this.formName = '';
              this.formEmail = '';
              this.formMessage = '';

              setTimeout(() => {
                showContactForm = false;
                this.messageSent = false;
              }, 2000);

            } catch (error) {
              // Sin esto, un servidor lento o caido deja el boton en
              // 'Sending...' para siempre y la persona no sabe que hacer.
              if (error.name === 'TimeoutError' || error.name === 'AbortError') {
                this.errorMessage = 'The server is taking too long to respond. Please try again, or write to us directly.';
              } else if (error instanceof TypeError) {
                this.errorMessage = 'Could not reach the server. Check your connection and try again.';
              } else {
                this.errorMessage = error.message || 'Could not send your message. Please try again.';
              }
            } finally {
              this.isSending = false;
            }
          }
        }"
        @submit.prevent="enviarFormulario"
      >
      
        <div class="space-y-4">
          <!-- Name -->
          <div>
            <label for="contact-name" class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
            <input 
              id="contact-name"
              name="name"
              type="text" 
              autocomplete="name"
              maxlength="120"
              x-model="formName"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
              placeholder="Your name"
            >
          </div>
          
          <!-- Email -->
          <div>
            <label for="contact-email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
            <input 
              id="contact-email"
              name="email"
              type="email" 
              autocomplete="email"
              maxlength="254"
              x-model="formEmail"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
              placeholder="your@email.com"
            >
          </div>
          
          <!-- Message -->
          <div>
            <label for="contact-message" class="block text-sm font-medium text-gray-700 mb-1">Message *</label>
            <textarea 
              id="contact-message"
              name="message"
              rows="4"
              maxlength="5000"
              x-model="formMessage"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
              placeholder="How can we help you?"
            ></textarea>
          </div>

          <!-- Campo trampa contra bots: invisible y fuera del orden de tabulacion -->
          <div class="hidden" aria-hidden="true">
            <label for="contact-website">Leave this field empty</label>
            <input
              id="contact-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
              x-model="formWebsite"
            >
          </div>
          
          <!-- Submit button -->
          <button 
            type="submit"
            :disabled="isSending"
            class="w-full py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition disabled:opacity-50"
          >
            <span x-show="!isSending">Send Message</span>
            <span x-show="isSending" class="flex items-center justify-center gap-2">
              <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
              </svg>
              Sending...
            </span>
          </button>
          
          
          <div x-show="messageSent" class="p-3 bg-green-100 text-green-700 rounded-lg text-center">
            Message sent successfully!
          </div>
          
          
          <div x-show="errorMessage" class="p-3 bg-red-100 text-red-700 rounded-lg text-center">
            <p x-text="errorMessage"></p>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  [x-cloak] { display: none !important; }
</style>
