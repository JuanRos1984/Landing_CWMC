# --- CMS -------------------------------------------------------------------
# URL base del Strapi que sirve el contenido. Sin barra final.
# No lleva el prefijo PUBLIC_ a proposito: solo se usa en el servidor.
STRAPI_URL=https://strapi-cwmc.onrender.com

# Milisegundos antes de dar por perdida una peticion a Strapi.
STRAPI_TIMEOUT_MS=8000

# Milisegundos que se reutiliza una respuesta cacheada antes de volver a pedirla.
STRAPI_CACHE_TTL_MS=60000

# --- Formulario de contacto ------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente verificado en Resend. Debe estar en el subdominio de envio,
# no en la raiz del dominio (la raiz la ocupa el SPF de Migadu).
FROM_EMAIL=no-reply@send.connectingwordsmc.com

# Buzon que recibe los mensajes del formulario.
# Solo el servidor decide esto: el navegador nunca lo envia.
CONTACT_TO_EMAIL=info@connectingwordsmc.com
