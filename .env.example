# --- CMS -------------------------------------------------------------------
# Direccion del Strapi que sirve el contenido. Sin barra final.
#
# Lleva el prefijo PUBLIC_ porque cumple dos funciones: traer los textos al
# compilar y quedar horneada en el HTML como destino del formulario de
# contacto. No es un secreto, es una direccion publica.
PUBLIC_STRAPI_URL=https://strapi-cwmc.onrender.com

# Milisegundos de espera al pedirle el contenido a Strapi durante la
# compilacion. Generoso a proposito: si el servicio esta dormido, tarda.
STRAPI_TIMEOUT_MS=90000

# Opcional. Solo si el formulario tuviera que apuntar a otro sitio distinto
# de PUBLIC_STRAPI_URL/api/contact.
# PUBLIC_CONTACT_ENDPOINT=https://strapi-cwmc.onrender.com/api/contact

# --- Nota sobre el correo --------------------------------------------------
# Las claves de Resend y las direcciones de envio ya no viven aqui. El
# formulario lo procesa Strapi, asi que RESEND_API_KEY, FROM_EMAIL y
# CONTACT_TO_EMAIL se configuran en el servicio de Strapi, no en este.
